#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/mman.h>
#include <sys/wait.h>
#include <semaphore.h>

#define BUFFER_SIZE 5
#define NUM_ITEMS 10

typedef struct {
    int buffer[BUFFER_SIZE];
    int in;
    int out;
} SharedData;

int main() {
    // 1. Setup shared memory for buffer and pointers
    SharedData *shared = mmap(NULL, sizeof(SharedData), 
                              PROT_READ | PROT_WRITE, 
                              MAP_SHARED | MAP_ANONYMOUS, -1, 0);
    if (shared == MAP_FAILED) {
        perror("mmap failed");
        exit(EXIT_FAILURE);
    }

    shared->in = 0;
    shared->out = 0;

    // 2. Unlink old named semaphores if they exist
    sem_unlink("/sem_mutex");
    sem_unlink("/sem_full");
    sem_unlink("/sem_empty");

    // 3. Initialize POSIX named semaphores
    sem_t *mutex = sem_open("/sem_mutex", O_CREAT | O_EXCL, 0666, 1);
    sem_t *full  = sem_open("/sem_full",  O_CREAT | O_EXCL, 0666, 0);
    sem_t *empty = sem_open("/sem_empty", O_CREAT | O_EXCL, 0666, BUFFER_SIZE);

    if (mutex == SEM_FAILED || full == SEM_FAILED || empty == SEM_FAILED) {
        perror("sem_open failed");
        exit(EXIT_FAILURE);
    }

    pid_t pid = fork();

    if (pid < 0) {
        perror("fork failed");
        exit(EXIT_FAILURE);
    }

    if (pid == 0) {
        // --- CONSUMER PROCESS ---
        for (int i = 1; i <= NUM_ITEMS; i++) {
            sem_wait(full);   // Wait if buffer is empty
            sem_wait(mutex);  // Lock critical section

            int item = shared->buffer[shared->out];
            printf("[Consumer] Consumed: %d from index %d\n", item, shared->out);
            shared->out = (shared->out + 1) % BUFFER_SIZE;

            sem_post(mutex);  // Unlock critical section
            sem_post(empty);  // Signal producer

            sleep(2); // Simulate processing time
        }

        // Cleanup in child
        sem_close(mutex);
        sem_close(full);
        sem_close(empty);
        exit(EXIT_SUCCESS);
    } else {
        // --- PRODUCER PROCESS ---
        for (int i = 1; i <= NUM_ITEMS; i++) {
            int item = rand() % 100 + 1; // Produce an item

            sem_wait(empty);  // Wait if buffer is full
            sem_wait(mutex);  // Lock critical section

            shared->buffer[shared->in] = item;
            printf("[Producer] Produced: %d at index %d\n", item, shared->in);
            shared->in = (shared->in + 1) % BUFFER_SIZE;

            sem_post(mutex);  // Unlock critical section
            sem_post(full);   // Signal consumer

            sleep(1); // Simulate work
        }

        // Wait for child process to finish
        wait(NULL);

        // Cleanup in parent
        sem_close(mutex);
        sem_close(full);
        sem_close(empty);
        sem_unlink("/sem_mutex");
        sem_unlink("/sem_full");
        sem_unlink("/sem_empty");
        munmap(shared, sizeof(SharedData));
    }

    return 0;
}